{
  "name": "@lefine/cli",
  "version": "0.9.0",
  "description": "Lefine from the terminal: sign in, then pull, push, check and publish your app strings",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lefine": "./dist/lefine.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lefinehq/sdk.git",
    "directory": "packages/lefine-cli"
  },
  "homepage": "https://lefine.ai",
  "keywords": [
    "lefine",
    "i18n",
    "localization",
    "strings",
    "cli"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "check:package": "bunx publint@0.3.25 --strict"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "ora": "^8.1.1",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43"
  },
  "engines": {
    "node": ">=20"
  }
}
